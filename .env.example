# ---------- Meta WhatsApp Business API ----------
# Any random string you choose. Paste the SAME value into
# Meta App > WhatsApp > Configuration > Webhook > Verify token.
WHATSAPP_VERIFY_TOKEN=my-super-secret-verify-token

# Permanent System User token (Meta Business Settings > System users > Generate token)
WHATSAPP_ACCESS_TOKEN=EAAG...

# Meta App > WhatsApp > API Setup > "Phone number ID"
WHATSAPP_PHONE_NUMBER_ID=123456789012345

# Graph API version used for outbound sends
WHATSAPP_API_VERSION=v22.0

# Meta App > Settings > Basic > App secret.
# Optional but recommended: enables X-Hub-Signature-256 payload verification.
META_APP_SECRET=

# ---------- Supabase ----------
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGci...
# Server-only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...

# ---------- AI (Anthropic / Claude) ----------
# console.anthropic.com -> API keys
ANTHROPIC_API_KEY=sk-ant-...

# Model id. Opus 5 is the default and most capable.
# Cheaper options: claude-sonnet-5, or claude-haiku-4-5 for high volume.
ANTHROPIC_MODEL=claude-opus-5

# Persona / instructions for the agent
AI_SYSTEM_PROMPT="You are a helpful WhatsApp assistant. Keep replies short, friendly and conversational — WhatsApp messages should rarely exceed 3 sentences. Never use markdown headings or tables."

# How many past messages to feed the model as context
AI_HISTORY_LIMIT=20
